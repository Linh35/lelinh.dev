.{
    // Where the public site lives (relative to this file).
    .site = "src",
    .out = "baked.bin",

    // Runtime listener.
    .port = 8001,
    .bind = "127.0.0.1",
    .bundle_path = "baked.bin",

    .compress = .{
        .brotli = true,
        .min_size = 0,
        // Source is the product — ship bytes as written. View-source must
        // match what the editor sees.
        .obfuscate = false,
    },

    .headers = .{
        .{ .name = "Cache-Control", .value = "public, max-age=3600" },
        .{ .name = "X-Content-Type-Options", .value = "nosniff" },
    },
}
